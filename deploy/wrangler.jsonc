// switcher.diananerd.com: the docs site (Workers Static Assets) and the short
// installer address, in one Worker on a Custom Domain.
//
//   cd docs && npm run deploy
{
  "$schema": "../docs/node_modules/wrangler/config-schema.json",
  "name": "claude-account-switcher",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../docs/.vitepress/dist",
    "binding": "ASSETS",
    // Only these paths reach the Worker, which decides installer vs site;
    // everything else is served straight from the assets.
    "run_worker_first": ["/", "/install.sh"],
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "switcher.diananerd.com", "custom_domain": true }],
  "observability": { "enabled": true }
}

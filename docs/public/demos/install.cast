[4.179, "o", "\u001b[?2004l\r\r\n"]
[4.18, "o", "\u001b]0;~ \u2014 curl\u0007"]
[4.615, "o", "\u001b[1mclaude-switcher installer\u001b[0m\r\n\r\n\u001b[1mFound\u001b[0m\r\n"]
[4.628, "o", "  System         macOS 15.0, arm64 -> aarch64-apple-darwin\r\n"]
[5.118, "o", "  Claude Code    2.0.0 at ~/.local/bin/claude\r\n"]
[5.119, "o", "  claude-switcher not installed in ~/.local/bin\r\n"]
[5.119, "o", "  Shell          /bin/zsh\r\n"]
[5.12, "o", "  PATH           includes ~/.local/bin\r\n"]
[5.12, "o", "\r\n"]
[5.12, "o", "\u001b[2mDownloading claude-switcher-aarch64-apple-darwin.tar.gz (latest)...\u001b[0m\r\n"]
[6.52, "o", "\u001b[32m\u2714\u001b[0m Verified claude-switcher 1.0.0 for aarch64-apple-darwin\r\n"]
[6.52, "o", "\r\nThis will:\r\n"]
[6.521, "o", "  - install claude-switcher 1.0.0 to ~/.local/bin\r\n"]
[6.526, "o", "  - add the shell integration to ~/.zshrc, so `claude` picks the account per folder\r\n"]
[6.529, "o", "  - add the short command csw (a link to claude-switcher)\r\n"]
[6.529, "o", "\r\n  \u001b[1m1)\u001b[0m Proceed \u001b[2m(default)\u001b[0m\r\n"]
[6.529, "o", "  \u001b[1m2)\u001b[0m Customize\r\n"]
[6.529, "o", "  \u001b[1m3)\u001b[0m Cancel\r\n"]
[6.529, "o", "\u001b[1m>\u001b[0m \u001b[2m[1]\u001b[0m "]
[7.732, "o", "\r\n"]
[7.755, "o", "\u001b[32m\u2714\u001b[0m Installed claude-switcher 1.0.0 to ~/.local/bin\r\n"]
[7.761, "o", "\u001b[32m\u2714\u001b[0m Added the short command csw\r\n"]
[8.019, "o", "\u001b[32m\u2714\u001b[0m Shell integration added to ~/.zshrc\r\n"]
[8.031, "o", "\r\n"]
[8.031, "o", "\u001b[1mSet up your accounts now (csw setup)?\u001b[0m [Y/n] "]
[8.532, "o", "n"]
[8.867, "o", "\r\n\r\n\u001b[1mNext steps\u001b[0m\r\n"]
[8.867, "o", "  1. Open a new terminal (or run: source ~/.zshrc)\r\n"]
[8.868, "o", "  2. Run \u001b[36mcsw setup\u001b[0m to name your accounts, log them in and map folders\r\n"]
[8.868, "o", "  3. Run \u001b[36mclaude\u001b[0m in any project: it uses that folder's account, or asks once\r\n"]
[8.868, "o", "\r\n"]
[8.868, "o", "Tip: \u001b[36mcsw\u001b[0m is short for claude-switcher, e.g. \u001b[36mcsw status\u001b[0m.\r\n\r\n"]
[8.868, "o", "\u001b[2mHelp: claude-switcher --help \u00b7 Docs: https://switcher.diananerd.com\u001b[0m\r\n"]
[8.887, "o", "\u001b]0;~\u0007"]
[8.887, "o", "\r\u001b[0m\u001b[27m\u001b[24m\u001b[J\u001b[38;5;245m~\u001b[39m \u001b[38;5;173m$\u001b[39m \u001b[K"]
[8.887, "o", "\u001b[?2004h"]

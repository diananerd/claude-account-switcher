[5.1, "o", "\u001b[32m\u2714\u001b[0m \u001b[1mProfile name (e.g. work, personal)\u001b[0m \u001b[38;5;8m\u00b7\u001b[0m \u001b[32mwork\u001b[0m\r\n"]
[5.1, "o", "\u001b[?25l\u001b[33m?\u001b[0m \u001b[1mWhat is work?\u001b[0m \u001b[38;5;8m\u203a\u001b[0m\r\n\u001b[32m\u276f\u001b[0m \u001b[36mA Claude account of its own (you log in to it next)\u001b[0m\r\n"]
[5.1, "o", "  Another name for an existing profile's login\r\n"]
[6.006, "o", "\u001b[3A\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\u001b[3A\u001b[32m\u2714\u001b[0m \u001b[1mWhat is work?\u001b[0m \u001b[38;5;8m\u00b7\u001b[0m \u001b[32mA Claude account of its own (you log in to it next)\u001b[0m\r\n\u001b[?25h"]
[6.028, "o", "\u001b[32m\u2714\u001b[0m Profile work: not logged in\r\n"]
[6.028, "o", "\u001b[33m?\u001b[0m \u001b[1mLog work in now?\u001b[0m \u001b[38;5;8m(y/n)\u001b[0m \u001b[38;5;8m\u203a\u001b[0m \u001b[36myes\u001b[0m"]
[6.028, "o", "\u001b[?25l"]
[6.829, "o", "\r\u001b[2K\u001b[32m\u2714\u001b[0m \u001b[1mLog work in now?\u001b[0m \u001b[38;5;8m\u00b7\u001b[0m \u001b[32myes\u001b[0m\r\n\u001b[?25h"]
[6.844, "o", "Logging in work. Claude Code opens your browser to sign in.\r\nThe browser signs in with whatever claude.ai account it is already using:\r\nif that is not the one for work, switch accounts there (or use a private window).\r\n"]
[6.851, "o", "Opening your browser to sign in...\r\n"]
[8.251, "o", "Login successful.\r\n"]
[8.261, "o", "\u001b[32m\u2714\u001b[0m work is logged in as you@company.com\r\n"]
[8.261, "o", "\u001b[33m?\u001b[0m \u001b[1mAdd one more?\u001b[0m \u001b[38;5;8m(y/n)\u001b[0m \u001b[38;5;8m\u203a\u001b[0m \u001b[36mno\u001b[0m\u001b[?25l"]
[9.165, "o", "\r\u001b[2K\u001b[32m\u2714\u001b[0m \u001b[1mAdd one more?\u001b[0m \u001b[38;5;8m\u00b7\u001b[0m \u001b[32mno\u001b[0m\r\n\u001b[?25h\r\n\u001b[2m[3/5]\u001b[0m \u001b[1mDefault profile\u001b[0m\r\n"]
[9.165, "o", "In a folder with no profile yet, `claude` asks which to use; the default comes first.\r\n"]
[9.165, "o", "\u001b[?25l\u001b[33m?\u001b[0m \u001b[1mDefault profile\u001b[0m \u001b[38;5;8m\u203a\u001b[0m \u001b[30m\u001b[47m \u001b[0m\r\n\u001b[32m\u276f\u001b[0m \u001b[36mp\u001b[0m\u001b[36me\u001b[0m\u001b[36mr\u001b[0m\u001b[36ms\u001b[0m\u001b[36mo\u001b[0m\u001b[36mn\u001b[0m\u001b[36ma\u001b[0m\u001b[36ml\u001b[0m\u001b[36m \u001b[0m\u001b[36m \u001b[0m\u001b[36my\u001b[0m\u001b[36mo\u001b[0m\u001b[36mu\u001b[0m\u001b[36m@\u001b[0m\u001b[36me\u001b[0m\u001b[36mx\u001b[0m\u001b[36ma\u001b[0m\u001b[36mm\u001b[0m\u001b[36mp\u001b[0m\u001b[36ml\u001b[0m\u001b[36me\u001b[0m\u001b[36m.\u001b[0m\u001b[36mc\u001b[0m\u001b[36mo\u001b[0m\u001b[36mm\u001b[0m\r\n  work      you@company.com\r\n"]
[10.068, "o", "\u001b[3A\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\u001b[3A\u001b[32m\u2714\u001b[0m \u001b[1mDefault profile\u001b[0m \u001b[38;5;8m\u00b7\u001b[0m \u001b[32mpersonal  you@example.com\u001b[0m\r\n\u001b[?25h"]
[10.081, "o", "\u001b[32m\u2714\u001b[0m Default for folders with no profile: personal\r\n\r\n\u001b[2m[4/5]\u001b[0m \u001b[1mFolders\u001b[0m\r\nMap folders to profiles; everything inside a folder inherits it. Leave empty to skip.\r\n"]
[10.081, "o", "\u001b[33m?\u001b[0m \u001b[1mFolder to map (empty to finish)\u001b[0m \u001b[38;5;8m\u203a\u001b[0m "]

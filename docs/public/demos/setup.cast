[1.839, "o", "claude-switcher runs several Claude Code accounts side by side, one per folder.\r\nFound 2.0.0 (Claude Code).\r\n"]
[1.839, "o", "\r\n"]
[1.839, "o", "\u001b[2m[1/5]\u001b[0m \u001b[1mYour current Claude Code login\u001b[0m"]
[1.839, "o", "\r\n"]
[1.846, "o", "Claude Code is logged in as you@example.com (in ~/.claude).\r\n"]
[1.846, "o", "\u001b[33m?\u001b[0m \u001b[1mName for this account (e.g. personal, work)\u001b[0m \u001b[38;5;8m\u203a\u001b[0m "]
